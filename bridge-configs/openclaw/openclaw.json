{
  "models": {
    "mode": "merge",
    "providers": {
      "friday-local": {
        "baseUrl": "http://127.0.0.1:18790/v1",
        "apiKey": "YOUR_API_KEY_PLACEHOLDER",
        "api": "openai-completions",
        "timeoutSeconds": 300,
        "models": [
          {
            "id": "YOUR_MODEL_NAME_PLACEHOLDER",
            "name": "Friday Local"
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": { "primary": "friday-local/YOUR_MODEL_NAME_PLACEHOLDER" },
      "models": {
        "friday-local/YOUR_MODEL_NAME_PLACEHOLDER": { "alias": "Friday" }
      }
    }
  }
}
